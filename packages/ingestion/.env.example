# Copy to .env (gitignored) to run the live assistant and its evaluation.
# Everything else in this package — tests, ingestion, retrieval — works without it.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to claude-haiku-4-5-20251001
# ASSISTANT_MODEL=claude-haiku-4-5-20251001

# Publishing the daily game needs no service: `yarn games publish` writes files
# into public/games/, which deploy with the app.
#
# GAMES_SALT names and encrypts those files so future games are not casually
# readable. It must match REACT_APP_GAMES_SALT in the root .env, or the app
# cannot read what this publishes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAMES_SALT=
