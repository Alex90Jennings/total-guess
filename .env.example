# Copy to .env and fill in from your Appwrite project (Settings > API credentials).
# Without these the game still plays as a guest; only accounts and synced stats need them.
REACT_APP_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
REACT_APP_APPWRITE_PROJECT_ID=total-guess
REACT_APP_APPWRITE_DATABASE_ID=totalguess
REACT_APP_APPWRITE_STATS_TABLE_ID=stats

# Shared secret for the published daily games. The same value must be set as
# GAMES_SALT in packages/ingestion/.env, and in the hosting provider's build
# environment. Without it the app cannot read the published games.
REACT_APP_GAMES_SALT=
